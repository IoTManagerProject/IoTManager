# Генерируемые артефакты
# API.cpp формирует PrepareProject.py («учёт вызовов модулей») — править модули
# нужно в src/modules/<тип>/<Модуль>/, а не в сгенерированном файле.
src/modules/API.cpp
# data_svelte проекта пересобирается при применении профиля: PrepareProject.py
# копирует набор из data_full/data_lite и дописывает items.json/flashProfile.json.
# ВАЖНО: data_full/ и data_lite/ — это ИСХОДНЫЕ наборы веб-данных (собранный UI),
# их содержимое, включая build/*.gz, должно оставаться в репозитории.
data_svelte/index.html
data_svelte/favicon.ico
data_svelte/items.json
data_svelte/flashProfile.json
data_svelte/widgets.json
data_svelte/build/

# Local documentation — keep in local environment only, do not commit/push
/AGENTS.md
# /CHANGELOG.md [DEPRECATED-игнор] — файл версионируется и пушится на GitHub (см. CHANGELOG)
/KODA.md
/README.md
